{
  "info": {
    "name": "Event Management System",
    "description": "API collection for the Event Management System project",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Technology\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            }
          }
        },
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            }
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Create Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Node.js Workshop\",\n  \"description\": \"Learn Node.js basics\",\n  \"date\": \"2026-12-01T10:00:00.000Z\",\n  \"location\": \"Cairo\",\n  \"capacity\": 50,\n  \"category\": \"REPLACE_WITH_CATEGORY_ID\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["events"]
            }
          }
        },
        {
          "name": "Get Events",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["events"]
            }
          }
        },
        {
          "name": "Get Events with Filters",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/events?location=Cairo&search=node",
              "host": ["{{baseUrl}}"],
              "path": ["events"],
              "query": [
                {
                  "key": "location",
                  "value": "Cairo"
                },
                {
                  "key": "search",
                  "value": "node"
                }
              ]
            }
          }
        },
        {
          "name": "Get Event By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/events/REPLACE_WITH_EVENT_ID",
              "host": ["{{baseUrl}}"],
              "path": ["events", "REPLACE_WITH_EVENT_ID"]
            }
          }
        },
        {
          "name": "Update Event",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Event Title\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events/REPLACE_WITH_EVENT_ID",
              "host": ["{{baseUrl}}"],
              "path": ["events", "REPLACE_WITH_EVENT_ID"]
            }
          }
        },
        {
          "name": "Delete Event",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/REPLACE_WITH_EVENT_ID",
              "host": ["{{baseUrl}}"],
              "path": ["events", "REPLACE_WITH_EVENT_ID"]
            }
          }
        }
      ]
    },
    {
      "name": "Registrations",
      "item": [
        {
          "name": "Register for Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/REPLACE_WITH_EVENT_ID/register",
              "host": ["{{baseUrl}}"],
              "path": ["events", "REPLACE_WITH_EVENT_ID", "register"]
            }
          }
        },
        {
          "name": "Cancel Registration",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/REPLACE_WITH_EVENT_ID/register",
              "host": ["{{baseUrl}}"],
              "path": ["events", "REPLACE_WITH_EVENT_ID", "register"]
            }
          }
        },
        {
          "name": "Get Event Registrations",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/events/REPLACE_WITH_EVENT_ID/registrations",
              "host": ["{{baseUrl}}"],
              "path": ["events", "REPLACE_WITH_EVENT_ID", "registrations"]
            }
          }
        }
      ]
    }
  ]
}
